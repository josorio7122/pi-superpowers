{
  "name": "pi-superpowers",
  "version": "0.1.0",
  "description": "Superpowers for pi — TDD, debugging, collaboration patterns, and proven techniques",
  "keywords": [
    "pi-package",
    "superpowers",
    "skills",
    "tdd",
    "debugging"
  ],
  "license": "MIT",
  "author": "josorio7122",
  "repository": "github:josorio7122/pi-superpowers",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./vendor/superpowers/skills"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PI_E2E=1 vitest run --config vitest.e2e.config.ts",
    "test:e2e:full": "PI_E2E=1 E2E_FULL=1 vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "format": "biome format --write src/",
    "lint:blanks": "bash scripts/check-blank-lines.sh",
    "check": "npm run lint && npm run lint:blanks && npm run typecheck && npm run test && npm run parity-check",
    "parity-check": "tsx scripts/parity-check.ts",
    "sync-upstream": "bash scripts/sync-upstream.sh",
    "simulate-ui": "tsx scripts/simulate-ui.ts",
    "simulate-ui:all": "tsx scripts/simulate-ui.ts all",
    "prepare": "simple-git-hooks 2>/dev/null || true"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "vendor",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "chalk": "^5.5.0",
    "gray-matter": "^4.0.3",
    "pi-agents": "github:josorio7122/pi-agents",
    "pi-tasks": "github:josorio7122/pi-tasks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.5.0",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
